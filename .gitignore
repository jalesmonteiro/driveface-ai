# ==============================================================================
# DriveFace AI - .gitignore
# ==============================================================================

# --- Ambientes Virtuais (Python Virtual Environments) ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Byte-compiled / Cache Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/

# --- Celery ---
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# --- Variáveis de Ambiente e Segredos ---
.env
.env.local
.env.*.local
!.env.example

# --- Testes e Cobertura (Pytest, Coverage) ---
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# --- Modelos de IA e Pesos Grandes (InsightFace, ONNX, Checkpoints) ---
models/
*.onnx
*.weights
*.pt
*.pth
*.bin
*.h5
*.tflite
.insightface/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- IDEs e Editores ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Sistema Operacional (Windows / macOS / Linux) ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Antigravity / Gemini Artifacts ---
.antigravity/
