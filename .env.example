# === Configurações do Django ===
DJANGO_ENV=development
DJANGO_SECRET_KEY=driveface_insecure_dev_secret_key_change_in_production_abcdef123456
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.driveface.ai

# === Banco de Dados (PostgreSQL 16 + pgvector) ===
POSTGRES_DB=driveface_db
POSTGRES_USER=driveface_admin
POSTGRES_PASSWORD=driveface_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://driveface_admin:driveface_secure_pass@localhost:5432/driveface_db

# === Cache & Celery Broker (Redis 7) ===
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Google Drive OAuth2 ===
# Preencha com as credenciais do Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback/

# === Pipeline de Visão & Limiares Matemáticos ===
# 'cuda' para GPU ou 'cpu' para fallback local
DEVICE=cpu
# InsightFace Model Zoo (RetinaFace + ArcFace)
FACE_DETECTION_MODEL=buffalo_l
# Limiar de confiança da detecção facial (Regra R_5)
FACE_DETECTION_CONFIDENCE_THRESHOLD=0.80
# Epsilon para agrupamento DBSCAN (Regra R_3)
CLUSTERING_COSINE_EPS=0.40
# Limiar para auto-sugestão de identidade (Regra R_4)
IDENTITY_SUGGESTION_THRESHOLD=0.35
